import sympy as sp

x,y,z,w,a,b=sp.symbols('x_1 x_2 x_3 x_4 alpha beta',real=True)

X=sp.Matrix([x,y,z,w])
A=sp.Matrix([[0,0,3,-9],[5,15,-10,40],[1,3,-1,5]])
B=sp.Matrix([6,-45,-7])
Ma=sp.Matrix.hstack(A,B)
system= A,B
sol=sp.linsolve(system,x,y,z,w)
S=sol.subs({y:a,w:b})
Me=Ma.echelon_form()

def aum(M):
 m=M.shape[1]
 col = 'c'*(m-1)+'|c'
 MM = sp.latex(M).replace(r'\begin{matrix}', r'\begin{array}{'+col+ '}')
 MM = MM.replace(r'\end{matrix}', r'\end{array}')
 return MM

pos,neg=sp.symbols('+ -')
def sinal(x):
 if x>0:
  return pos
 else:
  return neg

def opa(M,i,j):
 B=M.elementary_row_op(op='n<->m', row=None, k=None, row1=i-1, row2=j-1)
 L=r'L_{}'.format(i)+r'\leftrightarrow L_{}'.format(j)
 return B, L

def opb(M,i,r):
 rr=sp.Abs(r)
 if rr==1:
  rr=' '
 B=M.elementary_row_op(op='n->kn', row=i-1, k=r, row1=None, row2=None)
 L=r'L_{}'.format(i)+r'\to '+r'{}'.format(sinal(r))+r'{}'.format(rr)+r'L_{}'.format(i)
 return B, L

def opc(M,i,r,j):
 rr=sp.Abs(r)
 if rr==1:
  rr=' '
 B=M.elementary_row_op(op='n->n+km', row=i-1, k=r, row1=None, row2=j-1)
 L=r'L_{}'.format(i)+r'\to L_{}'.format(i)+r'{}'.format(sinal(r))+r'{}'.format(rr)+r'L_{}'.format(j)
 return B, L

def aumv(M):
 latexM = sp.latex(M).replace(r'\begin{matrix}', r'\begin{array}{cccc|c}')
 latexM = latexM.replace(r'\end{matrix}', r'\end{array}')
 return latexM

#1ª eliminação
