import sympy as sp
x,y,z,a=sp.symbols('x y z alpha',real=True)
A=sp.Matrix([[1,3,4],[2,-1,1]])
X=sp.Matrix([x,y,z])
B=sp.Matrix([1,2])
AX=A*X
v=sp.linsolve((A,B),(x,y,z))
u1=v.subs(z,2)
u1=next(iter(u1))
v1=sp.Matrix([u1[0],u1[1],u1[2]])
u2=v.subs(z,0)
u2=next(iter(u2))
v2=sp.Matrix([u2[0],u2[1],u2[2]])
u3=v.subs(z,-1)
u3=next(iter(u3))
v3=sp.Matrix([u3[0],u3[1],u3[2]])
