eq22=sp.Eq(AX2[1],B2[1])

def aumv(M):
 latexM = sp.latex(M).replace(r'\begin{matrix}', r'\begin{array}{ccc|c}')
 latexM = latexM.replace(r'\end{matrix}', r'\end{array}')
 return latexM
