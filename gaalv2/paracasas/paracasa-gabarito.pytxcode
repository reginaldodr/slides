import sympy as sp

A=sp.Matrix([[4,2,2],[2,4,2],[2,2,4]])
B=sp.Matrix([[-1,7,-1],[0,1,0],[0,15,-2]])

l=sp.symbols('lambda',real=True)
I3=sp.eye(3)
pa=sp.factor((A-l*sp.eye(3)).det())
autvaA = A.eigenvals()
autveA = A.eigenvects()
l1=autveA[0][0]
l2=autveA[1][0]

A1=A-l1*I3
RA1=A1.rref()[0]
sola1=sp.linsolve(RA1,(x,y,z))
sa1 = next(iter(sola1))
vla1 = tuple(sa1.free_symbols)

va1=autveA[0][2][0]
va2=autveA[0][2][1]

A2=A-l2*I3
RA2=A2.rref()[0]
sola2=sp.linsolve(RA2,(x,y,z))
sa2 = next(iter(sola2))
va3=autveA[1][2][0]

Pa=sp.Matrix.hstack(va1,va2,va3)
Da=sp.diag(l1,l1,l2)

