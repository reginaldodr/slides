import sympy as sp
def pt(Y):
 return((Y[0],Y[1],Y[2]))

t=sp.symbols('t',real=True)

A=sp.Matrix([0,1,8])
B=sp.Matrix([-3,0,9])
pr=sp.Matrix([1,2,0])
vr=sp.Matrix([1,1,-3])

X=pr+t*vr

XA=A-X
XB=B-X

eq=sp.Eq(XA.dot(XB),0)

T=sp.solve(eq,t)

c1=X.subs(t,T[0])
c2=X.subs(t,T[1])
