eq3=sp.Eq(AX[2],B[2])
Ma=sp.Matrix.hstack(A,B)
Me=Ma.echelon_form()

def aumv(M):
 latexM = sp.latex(M).replace(r'\begin{matrix}', r'\begin{array}{cccc|c}')
 latexM = latexM.replace(r'\end{matrix}', r'\end{array}')
 return latexM
