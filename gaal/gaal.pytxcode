import sympy as sp

x,y,z,a=sp.symbols('x y z a',real=True)
X=sp.Matrix([x,y,z])
L1=sp.Matrix([1,1,1,2]).T
L2=sp.Matrix([2,3,2,5]).T
L3=sp.Matrix([2,3,a**2-1,a+1]).T
M=sp.Matrix([L1,L2,L3])
A=M[:3,:3]
B=M[:,3:4]
AX=A*X
eq1=sp.Eq(AX[0],B[0])
eq2=sp.Eq(AX[1],B[1])
eq3=sp.Eq(AX[2],B[2])
=>PYTHONTEX#py#default#default#142#i####sistemas.tex#747#
