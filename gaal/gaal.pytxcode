import sympy as sp
import mpmath

u=sp.Matrix([1.12,-3.25,2.07,-1.83 ])
v=sp.Matrix([-2.29,1.72,4.33,-1.54])
uv=u.dot(v)
nu=u.norm()
nv=v.norm()
cos=uv/(nu*nv)
theta=sp.acos(cos)
thetag=round(mp.degrees(theta),2)
=>PYTHONTEX#py#default#default#56#code####vetores2.tex#230#
import sympy as sp
import mpmath as mp

u=sp.Matrix([1.12,-3.25,2.07,-1.83 ])
v=sp.Matrix([-2.29,1.72,4.33,-1.54])
uv=u.dot(v)
nu=u.norm()
nv=v.norm()
cos=uv/(nu*nv)
theta=sp.acos(cos)
thetag=round(mp.degrees(theta),2)
