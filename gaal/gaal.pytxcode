import sympy as sp

x,y,z=sp.symbols('x y z',real=True)

sep=sp.symbols('|')
Msep=sp.Matrix([sep,sep])

def aum(X):
 return sp.Matrix.hstack(X[:,:3],Msep,X[:,3:])


X=sp.Matrix([x,y,z])
A=sp.Matrix([[2, -1,1],[1,3,4]])
B=sp.Matrix([2,1])
AX=A*X
eq1=sp.Eq(AX[0],B[0])
eq2=sp.Eq(AX[1],B[1])
sol=sp.solve(sp.Eq(AX,B),(x,y,z))
MA=sp.Matrix.hstack(A,B)
MA2=sp.Matrix([MA.row(0),-2*MA.row(1)+MA.row(0)])
A2=MA2[:,0:3]
B2=MA2[:,3:4]
AX2=A2*X
eq12=sp.Eq(AX2[0],B2[0])
eq22=sp.Eq(AX2[1],B2[1])

def aumv(M):
 latexM = sp.latex(M).replace(r'\begin{matrix}', r'\begin{array}{ccc|c}')
 latexM = latexM.replace(r'\end{matrix}', r'\end{array}')
 return latexM
