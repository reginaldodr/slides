import sympy as sp

x,y,z,w=sp.symbols('x y z w',real=True)
X=sp.Matrix([x,y,z,w])
A=sp.Matrix([[0,0,3,-9],[5,15,-10,40],[1,3,-1,5]])
B=sp.Matrix([6,-45,-7])
AX=A*X
eq1=sp.Eq(AX[0],B[0])
eq2=sp.Eq(AX[1],B[1])
eq3=sp.Eq(AX[2],B[2])
Ma=sp.Matrix.hstack(A,B)
Me=Ma.echelon_form()
