import sympy as sp

x,y,z=sp.symbols('x y z',real=True)
X=sp.Matrix([x,y,z])
L1=sp.Matrix([3,-1,2,1]).T
L2=sp.Matrix([-2,1,1,0]).T
L3=-2*L1+L2
M=sp.Matrix([L1,L2,L3])
A=M[:3,:3]
B=M[:,3:4]
AX=A*X
eq1=sp.Eq(AX[0],B[0])
eq2=sp.Eq(AX[1],B[1])
eq3=sp.Eq(AX[2],B[2])
=>PYTHONTEX#py#default#default#129#i####sistemas.tex#668#
sp.latex(eq1)
