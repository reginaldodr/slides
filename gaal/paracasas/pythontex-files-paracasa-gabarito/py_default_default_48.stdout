\begin{tikzpicture}[scale=1]
\tikzset{>=latex}
\draw[help lines, color=gray!30, dashed] (-3.5,-3.5) grid (2.5,3.5);
\draw[->,thick] (-3.5,0)--(2.5,0) node[right]{$x$}; \draw[->,thick] (0,-3.5)--(0,3.5) node[above]{$y$}; \draw[->,thick] (-3.5,0)--(2.5,0) node[right]{$x$}; \draw[->,thick] (0,-3.5)--(0,3.5) node[above]{$y$}; \foreach \i in {-3,...,2} \node[below,scale=0.7] at (\i,0) {$\i$}; \foreach \i in {-3,...,3} \node[left,scale=0.7] at (0,\i) {$\i$}; \coordinate (O) at (0,0); \coordinate (A) at ( 0 , 1 ); \coordinate (B) at ( 1 , 1 ); \coordinate (C) at ( 1 , 3 ); \node[red] at (A) {\textbullet}; \node[red,below left] at (A) {$A$}; \node[red] at (B) {\textbullet}; \node[red,right] at (B) {$B$}; \node[red] at (C) {\textbullet}; \node[red,above] at (C) {$C$}; \draw[-,thick,red] (A)--(B); \draw[-,thick,red] (A)--(C); \draw[-,thick,red] (B)--(C); \coordinate (A1) at ( -1 , 0 ); \coordinate (B1) at ( -1 , 1 ); \coordinate (C1) at ( -3 , 1 ); \node[red] at (A1) {\textbullet}; \node[red,below left] at (A1) {$A^\prime$}; \node[red] at (B1) {\textbullet}; \node[red,above] at (B1) {$B^\prime$}; \node[red] at (C1) {\textbullet}; \node[red,above] at (C1) {$C^\prime$}; \draw[-,thick,red] (A1)--(B1); \draw[-,thick,red] (A1)--(C1); \draw[-,thick,red] (B1)--(C1); \coordinate (A2) at ( 0 , -1 ); \coordinate (B2) at ( 1 , -1 ); \coordinate (C2) at ( 1 , -3 ); \node[red] at (A2) {\textbullet}; \node[red,above left] at (A2) {$A^{\prime\prime}$}; \node[red] at (B2) {\textbullet}; \node[red,above] at (B2) {$B^{\prime\prime}$}; \node[red] at (C2) {\textbullet}; \node[red,below] at (C2) {$C^{\prime\prime}$}; \draw[-,thick,red] (A2)--(B2); \draw[-,thick,red] (A2)--(C2); \draw[-,thick,red] (B2)--(C2); \draw[dashed] (-3,-3)--(2,2);
