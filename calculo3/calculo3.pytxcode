=>PYTHONTEX#py#default#defaultverb#0#verbatim####polares.tex#112#
import numpy as np
import matplotlib.pyplot as plt

plt.axes(projection = 'polar')

plt.polar(5*np.pi/4,1, 'g.')
plt.polar(3*np.pi,2, 'b.')
plt.polar(-2*np.pi/3,2, 'k.')
plt.polar(3*np.pi/4,3, 'r.')
plt.polar(3*np.pi/4+np.pi,3, 'r.')

plt.show()
=>PYTHONTEX#py#default#defaultverb#1#verbatim####polares.tex#171#
import matplotlib.pyplot as plt
import numpy as np

theta= np.linspace(0, 2*np.pi, 60)
r=1+np.cos(theta)

theta=np.where(r >= 0, theta,theta + np.pi)

plt.polar(theta, np.abs(r))
plt.show()
